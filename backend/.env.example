# APP_ENV escolhe qual DATABASE_URL_* é usada: "test" (padrão) ou "production"
APP_ENV=test
DATABASE_URL_TEST=mysql+pymysql://usuario:senha@localhost:3306/nome_do_banco
DATABASE_URL_PROD=mysql+pymysql://usuario:senha@host-producao:3306/nome_do_banco
SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_PIXABAY_URL=https://pixabay.com/api/
API_PIXABAY_KEY=your_pixabay_api_key
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret